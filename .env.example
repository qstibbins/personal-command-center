POSTGRES_USER=pcc
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=pcc
DATABASE_URL=postgresql+psycopg://pcc:local_dev_only_change_me@localhost:5432/pcc
REDIS_URL=redis://localhost:6379/0

# Next.js → FastAPI (server-only). Required for capture create/list.
# Generate a long random value for local use, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the SAME value in the environment for both the API process and the
# Next.js process. Never prefix with NEXT_PUBLIC_ and never commit real secrets.
PCC_SERVICE_CREDENTIAL=local_dev_change_me_use_a_long_random_value

# Optional previous credential accepted during planned rotation (dual-read).
# Leave empty in normal local development.
# PCC_SERVICE_CREDENTIAL_PREVIOUS=

# Next.js server → FastAPI base URL (server-only; not exposed to the browser).
API_INTERNAL_URL=http://localhost:8000

# Isolated Postgres database for backend API tests (name must be exactly pcc_test).
TEST_DATABASE_URL=postgresql+psycopg://pcc:local_dev_only_change_me@localhost:5432/pcc_test

# Reserved / unused by current code (may be wired in a later milestone):
# API_CORS_ORIGINS=http://localhost:3000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
