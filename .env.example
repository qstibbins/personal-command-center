POSTGRES_USER=pcc
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=pcc
DATABASE_URL=postgresql+psycopg://pcc:local_dev_only_change_me@localhost:5432/pcc
REDIS_URL=redis://localhost:6379/0

# Next.js → FastAPI (server-only). Required for capture create/list.
# Generate a long random value for local use, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the SAME value in the environment for both the API process and the
# Next.js process. Never prefix with NEXT_PUBLIC_ and never commit real secrets.
PCC_SERVICE_CREDENTIAL=local_dev_change_me_use_a_long_random_value

# Optional previous credential accepted during planned rotation (dual-read).
# Leave empty in normal local development.
# PCC_SERVICE_CREDENTIAL_PREVIOUS=

# Next.js server → FastAPI base URL (server-only; not exposed to the browser).
API_INTERNAL_URL=http://localhost:8000

# Isolated Postgres database for backend API tests (name must be exactly pcc_test).
TEST_DATABASE_URL=postgresql+psycopg://pcc:local_dev_only_change_me@localhost:5432/pcc_test

# --- Milestone 3.3: Auth.js v5 Google sign-in (server-only; never NEXT_PUBLIC_) ---

# Auth.js session encryption/signing secret. Generate with:
#   openssl rand -base64 32
# or:  npx auth secret
AUTH_SECRET=local_dev_change_me_generate_with_openssl_rand

# Google OAuth 2.0 Web client credentials from Google Cloud Console.
# Authorized redirect URI (local): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated allowlist of Google account emails (initially one).
# Required: missing/empty fail closed (no one can sign in).
# Matching is case-insensitive exact match against Google's verified email.
PCC_ALLOWED_GOOGLE_EMAILS=you@example.com

# Optional Auth.js / pg connection URL. When unset, DATABASE_URL is used and
# postgresql+psycopg:// is rewritten to postgresql:// for the `pg` driver.
# AUTH_DATABASE_URL=postgresql://pcc:local_dev_only_change_me@localhost:5432/pcc

# Optional public origin for Auth.js (useful behind proxies). Local default is
# inferred when trustHost is enabled.
# AUTH_URL=http://localhost:3000

# --- Milestone 3.4: scoped API tokens ---
# No additional secrets are required. Tokens are created by an allowlisted
# signed-in owner at /settings/api-tokens. FastAPI stores only SHA-256 hashes.
# The Next.js server calls token management routes with PCC_SERVICE_CREDENTIAL
# after the Auth.js session check. Never commit raw API tokens.

# Reserved / unused by current code (may be wired in a later milestone):
# API_CORS_ORIGINS=http://localhost:3000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
